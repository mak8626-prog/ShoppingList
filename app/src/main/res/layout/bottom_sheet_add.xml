<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Новый товар"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/bsChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="0dp"
            app:singleSelection="true"
            app:singleLine="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <AutoCompleteTextView
            android:id="@+id/bsEditItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Что купить?"
            android:completionThreshold="1"
            android:inputType="textCapSentences"
            android:imeOptions="actionDone"
            android:textSize="15sp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/bsBtnMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Минус"
            android:src="@drawable/ic_minus"
            android:scaleType="centerInside" />

        <EditText
            android:id="@+id/bsEditQuantity"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:inputType="number"
            android:text="1"
            android:textSize="15sp"
            android:maxLines="1"
            android:background="@android:color/transparent" />

        <ImageButton
            android:id="@+id/bsBtnPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Плюс"
            android:src="@drawable/ic_plus"
            android:scaleType="centerInside" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bsBtnTogglePrice"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="+ ₽"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/priceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/bsEditPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Цена за единицу"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/bsBtnClosePrice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Скрыть цену"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bsBtnAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Добавить"
        android:textSize="16sp"
        android:padding="14dp"
        app:cornerRadius="14dp" />
</LinearLayout>
