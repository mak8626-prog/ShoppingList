<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.ShoppingList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="chipStyle">@style/SmallChip</item>
    </style>

    <!-- Зелёная (по умолчанию) -->
    <style name="Theme.ShoppingList" parent="Base.Theme.ShoppingList">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryContainer">@color/primary_green_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_green_container</item>
    </style>

