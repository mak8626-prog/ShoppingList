        <item name="colorPrimary">@color/primary_indigo</item>
        <item name="colorPrimaryContainer">@color/primary_indigo_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_indigo_container</item>
    </style>

    <style name="Theme.ShoppingList.Teal" parent="Base.Theme.ShoppingList">
        <item name="colorPrimary">@color/primary_teal</item>
